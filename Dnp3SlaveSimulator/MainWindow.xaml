<Window x:Class="Dnp3SlaveSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Dnp3SlaveSimulator.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="DNP3 Slave Simulator"
        Width="1540"
        Height="930"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ObjectDataProvider x:Key="PointTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Dnp3OutstationPointType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EventClassValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Dnp3EventClassModel" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AnalogAnimationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AnalogAnimationKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="DiscreteAnimationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DiscreteAnimationKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="BinaryCommandBehaviorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BinaryCommandBehavior" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="16"
                Padding="20"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#1F1F1F"
                               Text="DNP3 Slave Simulator" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#4B4B4B"
                               Text="Outstation simulator for interoperability, FAT, measurement animation, binary status toggle, and DNP3 command lifecycle validation." />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#5C5C5C"
                               Text="{Binding ConnectionSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <StackPanel Margin="0,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Foreground="#5C5C5C"
                                   Text="Signal Profile" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding SignalProfileName, Mode=OneWay}" />
                    </StackPanel>
                    <Button Width="120"
                            Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding StartRuntimeCommand}"
                            Content="Start Runtime" />
                    <Button Width="120"
                            Height="38"
                            Command="{Binding StopRuntimeCommand}"
                            Content="Stop Runtime" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Padding="16"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,6" Text="Transport" />
                <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Connection.Transport}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,12,6" Text="TCP Endpoint" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding Connection.Endpoint}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,12,6" Text="Serial Port" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,12,0" Text="{Binding Connection.SerialPort}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,12,6" Text="Master Addr" />
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,12,0" Text="{Binding Connection.MasterAddress}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,0,12,6" Text="Outstation Addr" />
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,0,12,0" Text="{Binding Connection.OutstationAddress}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0" Grid.Column="5" Margin="0,0,12,6" Text="Port Retry (s)" />
                <TextBox Grid.Row="1" Grid.Column="5" Margin="0,0,12,0" Text="{Binding Connection.PortRetrySeconds}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="6"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Foreground="#5B5B5B"
                           Text="Manage signal profiles and points from the Point Database panel below." />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,12,0"
                    Padding="16"
                    Background="White"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Point Database" />
                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding SignalProfiles}"
                                      SelectedItem="{Binding SelectedSignalProfile}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanEditSettings}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Margin="0,28,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#5B5B5B"
                                   Text="Profile JSON is loaded at startup. Use default for debugging and ElectraNet for FAT validation." />

                        <Button Grid.Column="2"
                                Width="88"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding SaveProfileCommand}"
                                Content="Save" />
                        <Button Grid.Column="3"
                                Width="88"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding ReloadProfileCommand}"
                                Content="Reload" />
                        <Button Grid.Column="4"
                                Width="100"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding AddPointCommand}"
                                Content="Add Point" />
                        <Button Grid.Column="5"
                                Width="110"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding RemovePointCommand}"
                                Content="Delete Point" />
                        <Button Grid.Column="6"
                                Width="120"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding ToggleSelectedCommand}"
                                Content="Toggle Binary" />
                        <Button Grid.Column="7"
                                Width="120"
                                Height="34"
                                Margin="0,28,0,0"
                                Command="{Binding NudgeAnalogCommand}"
                                Content="Nudge Analog" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding Signals}"
                              SelectedItem="{Binding SelectedSignal}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Header="Index" Binding="{Binding Index}" />
                            <DataGridTextColumn Width="220" Header="Label" Binding="{Binding Label}" />
                            <DataGridComboBoxColumn Width="150" Header="Point Type" ItemsSource="{Binding Source={StaticResource PointTypeValues}}" SelectedItemBinding="{Binding PointType}" />
                            <DataGridComboBoxColumn Width="100" Header="Class" ItemsSource="{Binding Source={StaticResource EventClassValues}}" SelectedItemBinding="{Binding EventClass}" />
                            <DataGridCheckBoxColumn Width="75" Header="Enabled" Binding="{Binding IsEnabled}" />
                            <DataGridCheckBoxColumn Width="75" Header="Bool" Binding="{Binding BoolValue}" />
                            <DataGridTextColumn Width="90" Header="Analog" Binding="{Binding AnalogValue, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Min" Binding="{Binding AnalogMin, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Max" Binding="{Binding AnalogMax, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Step" Binding="{Binding AnalogStep, StringFormat=0.###}" />
                            <DataGridComboBoxColumn Width="120" Header="Analog Mode" ItemsSource="{Binding Source={StaticResource AnalogAnimationValues}}" SelectedItemBinding="{Binding AnalogAnimation}" />
                            <DataGridComboBoxColumn Width="120" Header="Discrete Mode" ItemsSource="{Binding Source={StaticResource DiscreteAnimationValues}}" SelectedItemBinding="{Binding DiscreteAnimation}" />
                            <DataGridTextColumn Width="110" Header="Anim ms" Binding="{Binding AnimationIntervalMs}" />
                            <DataGridTextColumn Width="110" Header="Toggle s" Binding="{Binding ToggleIntervalSeconds}" />
                            <DataGridCheckBoxColumn Width="90" Header="Timestamp" Binding="{Binding UseTimestamp}" />
                            <DataGridCheckBoxColumn Width="95" Header="Cmd Sim" Binding="{Binding BinaryCommand.IsEnabled}" />
                            <DataGridTextColumn Width="95" Header="Fb Index" Binding="{Binding BinaryCommand.FeedbackIndex}" />
                            <DataGridComboBoxColumn Width="160" Header="Cmd Behavior" ItemsSource="{Binding Source={StaticResource BinaryCommandBehaviorValues}}" SelectedItemBinding="{Binding BinaryCommand.Behavior}" />
                            <DataGridTextColumn Width="110" Header="Fb Delay ms" Binding="{Binding BinaryCommand.FeedbackDelayMs}" />
                            <DataGridTextColumn Width="130" Header="Command Status" Binding="{Binding LastCommandStatus}" IsReadOnly="True" />
                            <DataGridTextColumn Width="240" Header="Command Detail" Binding="{Binding LastCommandDetail}" IsReadOnly="True" />
                            <DataGridTextColumn Width="260" Header="Notes" Binding="{Binding Notes}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Session" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="#5B5B5B"
                                   Text="Runtime State" />
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding RuntimeState}" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="#5B5B5B"
                                   Text="Status" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Runtime Log" />
                            <Button Grid.Column="1"
                                    Width="88"
                                    Height="30"
                                    Command="{Binding ClearLogCommand}"
                                    Content="Clear" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding RuntimeLog}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="160" Header="Timestamp" Binding="{Binding TimestampLocal, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" />
                                <DataGridTextColumn Width="110" Header="Category" Binding="{Binding Category}" />
                                <DataGridTextColumn Width="*" Header="Message" Binding="{Binding Message}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
