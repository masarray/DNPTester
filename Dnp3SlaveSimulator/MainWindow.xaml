<Window x:Class="Dnp3SlaveSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Dnp3SlaveSimulator.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="DNP3 Slave Simulator"
        Width="1540"
        Height="930"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ObjectDataProvider x:Key="PointTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Dnp3OutstationPointType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EventClassValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Dnp3EventClassModel" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AnalogAnimationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AnalogAnimationKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="DiscreteAnimationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DiscreteAnimationKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="BinaryCommandBehaviorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BinaryCommandBehavior" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="16,16,16,12"
                Padding="20"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="DNP3 Slave Simulator" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Outstation simulator for FAT, interoperability, measurement animation, and DNP3 command lifecycle validation." />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <StackPanel Margin="0,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   Text="Signal Profile" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding SignalProfileName}" />
                    </StackPanel>
                    <Button Width="108"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="OpenConnectionSetup_Click"
                            Content="Configure" />
                    <Button Width="120"
                            Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding StartRuntimeCommand}"
                            Content="Start Runtime" />
                    <Button Width="120"
                            Height="38"
                            Command="{Binding StopRuntimeCommand}"
                            Content="Stop Runtime" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="16,0,16,12"
                Padding="12,10"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding ConnectionSummary}" />
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="260" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,12"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Point Database" />
                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding SignalProfiles}"
                                      SelectedItem="{Binding SelectedSignalProfile}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanEditSettings}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Margin="0,28,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Use default for debugging and ElectraNet for FAT validation." />

                        <Button Grid.Column="2"
                                Width="88"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding SaveProfileCommand}"
                                Content="Save" />
                        <Button Grid.Column="3"
                                Width="88"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding ReloadProfileCommand}"
                                Content="Reload" />
                        <Button Grid.Column="4"
                                Width="100"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding AddPointCommand}"
                                Content="Add Point" />
                        <Button Grid.Column="5"
                                Width="110"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding RemovePointCommand}"
                                Content="Delete Point" />
                        <Button Grid.Column="6"
                                Width="120"
                                Height="34"
                                Margin="0,28,8,0"
                                Command="{Binding ToggleSelectedCommand}"
                                Content="Toggle Binary" />
                        <Button Grid.Column="7"
                                Width="120"
                                Height="34"
                                Margin="0,28,0,0"
                                Command="{Binding NudgeAnalogCommand}"
                                Content="Nudge Analog" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding Signals}"
                              SelectedItem="{Binding SelectedSignal}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Header="Index" Binding="{Binding Index}" />
                            <DataGridTextColumn Width="220" Header="Label" Binding="{Binding Label}" />
                            <DataGridComboBoxColumn Width="150" Header="Point Type" ItemsSource="{Binding Source={StaticResource PointTypeValues}}" SelectedItemBinding="{Binding PointType}" />
                            <DataGridComboBoxColumn Width="100" Header="Class" ItemsSource="{Binding Source={StaticResource EventClassValues}}" SelectedItemBinding="{Binding EventClass}" />
                            <DataGridCheckBoxColumn Width="75" Header="Enabled" Binding="{Binding IsEnabled}" />
                            <DataGridCheckBoxColumn Width="75" Header="Bool" Binding="{Binding BoolValue}" />
                            <DataGridTextColumn Width="90" Header="Analog" Binding="{Binding AnalogValue, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Min" Binding="{Binding AnalogMin, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Max" Binding="{Binding AnalogMax, StringFormat=0.###}" />
                            <DataGridTextColumn Width="80" Header="Step" Binding="{Binding AnalogStep, StringFormat=0.###}" />
                            <DataGridComboBoxColumn Width="120" Header="Analog Mode" ItemsSource="{Binding Source={StaticResource AnalogAnimationValues}}" SelectedItemBinding="{Binding AnalogAnimation}" />
                            <DataGridComboBoxColumn Width="120" Header="Discrete Mode" ItemsSource="{Binding Source={StaticResource DiscreteAnimationValues}}" SelectedItemBinding="{Binding DiscreteAnimation}" />
                            <DataGridTextColumn Width="110" Header="Anim ms" Binding="{Binding AnimationIntervalMs}" />
                            <DataGridTextColumn Width="110" Header="Toggle s" Binding="{Binding ToggleIntervalSeconds}" />
                            <DataGridCheckBoxColumn Width="90" Header="Timestamp" Binding="{Binding UseTimestamp}" />
                            <DataGridCheckBoxColumn Width="95" Header="Cmd Sim" Binding="{Binding BinaryCommand.IsEnabled}" />
                            <DataGridCheckBoxColumn Width="70" Header="Use Fb" Binding="{Binding FeedbackMappingEnabled}" />
                            <DataGridTextColumn Width="220" Header="Feedback Control" Binding="{Binding FeedbackControl}" IsReadOnly="True" />
                            <DataGridTextColumn Width="95" Header="Fb Index" Binding="{Binding FeedbackIndex}" />
                            <DataGridComboBoxColumn Width="140" Header="Fb Type" ItemsSource="{Binding Source={StaticResource PointTypeValues}}" SelectedItemBinding="{Binding FeedbackPointType}" />
                            <DataGridTextColumn Width="220" Header="Feedback Name" Binding="{Binding FeedbackDisplayName}" />
                            <DataGridTextColumn Width="110" Header="Timeout ms" Binding="{Binding FeedbackTimeoutMs}" />
                            <DataGridComboBoxColumn Width="160" Header="Cmd Behavior" ItemsSource="{Binding Source={StaticResource BinaryCommandBehaviorValues}}" SelectedItemBinding="{Binding BinaryCommand.Behavior}" />
                            <DataGridTextColumn Width="110" Header="Fb Delay ms" Binding="{Binding BinaryCommand.FeedbackDelayMs}" />
                            <DataGridTextColumn Width="130" Header="Command Status" Binding="{Binding LastCommandStatus}" IsReadOnly="True" />
                            <DataGridTextColumn Width="240" Header="Command Detail" Binding="{Binding LastCommandDetail}" IsReadOnly="True" />
                            <DataGridTextColumn Width="260" Header="Notes" Binding="{Binding Notes}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Session" />
                    <TextBlock Margin="0,12,0,4"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Runtime State" />
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="{Binding RuntimeState}" />
                    <TextBlock Margin="0,12,0,4"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Status" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding StatusText}" />
                    <TextBlock Margin="0,12,0,4"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Communication Summary" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding ConnectionSummary}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Runtime Log" />
                        <Button Grid.Column="1"
                                Width="88"
                                Height="30"
                                Command="{Binding ClearLogCommand}"
                                Content="Clear" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding RuntimeLog}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Header="Timestamp" Binding="{Binding TimestampLocal, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" />
                            <DataGridTextColumn Width="120" Header="Category" Binding="{Binding Category}" />
                            <DataGridTextColumn Width="*" Header="Message" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
