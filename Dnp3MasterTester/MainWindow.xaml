<Window x:Class="Dnp3MasterTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DNP3 Master Tester"
        Icon="Assets/dnp-tester.ico"
        Height="920"
        Width="1580"
        MinHeight="760"
        MinWidth="1240">
    <Window.Resources>
        <Style x:Key="GridTextLeftStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <Style x:Key="GridTextCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextLeftStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>

        <Style x:Key="GridTextRightStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextLeftStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,10,0" />
        </Style>

        <Style x:Key="GridTextDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextLeftStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ReportTableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReportTableMutedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource ReportTableCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>


        <!-- Window-level scrollbar override.
             This is intentionally placed in MainWindow.Resources so it wins over App.xaml.
             Goal: normal visible web-app style scrollbar, not tiny/noise-like dot. -->
        <Style x:Key="WindowModernScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowModernScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="#8E99A8"
                                BorderBrush="#7B8796"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="3,4"
                                Opacity="0.96"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#6F7C8C" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#647182" />
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#566474" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#4C5968" />
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Width="16"
                              Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Border x:Name="TrackRail"
                                    Width="10"
                                    HorizontalAlignment="Center"
                                    Background="#EEF2F6"
                                    BorderBrush="#DDE5EE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Opacity="1" />
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PART_DecreaseButton"
                                                  Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource WindowModernScrollBarButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb"
                                           Width="10"
                                           Height="72"
                                           MinWidth="10"
                                           MinHeight="72"
                                           Style="{StaticResource WindowModernScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PART_IncreaseButton"
                                                  Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource WindowModernScrollBarButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto" />
                                <Setter TargetName="Root" Property="Height" Value="16" />
                                <Setter TargetName="TrackRail" Property="Width" Value="Auto" />
                                <Setter TargetName="TrackRail" Property="Height" Value="10" />
                                <Setter TargetName="TrackRail" Property="HorizontalAlignment" Value="Stretch" />
                                <Setter TargetName="TrackRail" Property="VerticalAlignment" Value="Center" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="PART_IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                                <Setter TargetName="PART_Thumb" Property="Width" Value="72" />
                                <Setter TargetName="PART_Thumb" Property="Height" Value="10" />
                                <Setter TargetName="PART_Thumb" Property="MinWidth" Value="72" />
                                <Setter TargetName="PART_Thumb" Property="MinHeight" Value="10" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="MinHeight" Value="16" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackRail" Property="Background" Value="#E5EBF2" />
                                <Setter TargetName="TrackRail" Property="BorderBrush" Value="#CDD8E4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackRail" Property="Opacity" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F7FFFFFF"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="55"
                            Height="55"
                            CornerRadius="8"
                            Background="White"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,14,0"
                            Padding="4" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform Y="-3"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Image Source="Assets/dnp-tester-icon.png"
                               Width="49"
                               Height="49"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="DNP3 Interoperability Tester"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ConnectionState}" FontWeight="SemiBold" />
                            <TextBlock Text="  /  " Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ConnectionProfile}" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="  /  " Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ConnectionTarget, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F2F7F9"
                        BorderBrush="#D4E0E8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="OpenConnectionSetup_Click"
                                ToolTip="Connection Setup">
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M20 13 C20 18 16.5 20.5 12.34 21.95 A1 1 0 0 1 11.67 21.94 C7.5 20.5 4 18 4 13 V6 A1 1 0 0 1 5 5 C7 5 9.5 3.8 11.24 2.28 A1.17 1.17 0 0 1 12.76 2.28 C14.51 3.81 17 5 19 5 A1 1 0 0 1 20 6 Z M12 8 V16 M8 12 H16" />
                        </Button>
                        <Button Style="{StaticResource ToolbarPrimaryButtonStyle}"
                                Command="{Binding ConnectCommand}"
                                ToolTip="Connect">
                            <Path Style="{StaticResource ToolbarPrimaryIconPathStyle}"
                                  Data="M12 22 A10 10 0 1 0 12 2 A10 10 0 0 0 12 22 Z M10 8 L16 12 L10 16 Z" />
                        </Button>
                        <Button Style="{StaticResource ToolbarDangerButtonStyle}"
                                Command="{Binding DisconnectCommand}"
                                ToolTip="Disconnect">
                            <Path Style="{StaticResource ToolbarDangerIconPathStyle}"
                                  Data="M18 6 L6 18 M6 6 L18 18" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding IntegrityPollCommand}"
                                ToolTip="Integrity Poll">
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M3 6 H15 M3 12 H12 M3 18 H15 M18 9 L21 12 L18 15 M21 12 H14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding EventPollCommand}"
                                ToolTip="Event Poll">
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M22 12 H18 L15 21 L9 3 L6 12 H2" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding LinkStatusCommand}"
                                ToolTip="Link Status">
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M12 2 V6 M12 18 V22 M2 12 H6 M18 12 H22 M12 16 A4 4 0 1 0 12 8 A4 4 0 0 0 12 16 Z" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <TabControl x:Name="MainTabs"
                        Loaded="MainTabs_OnLoaded"
                        SelectionChanged="MainTabs_OnSelectionChanged"
                        SizeChanged="MainTabs_OnSizeChanged">
                <TabItem Header="Mission Control">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource MetricPanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="SESSION" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding ConnectionState}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricPanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE VALUES" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding LiveValueCount}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Current point cache" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricPanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="SCADA EVENTS" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding EventLogCount}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Operator evidence" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricPanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="SOE RECORDS" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding SoeAuditCount}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Timestamp audit" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource MetricPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="POINT DATABASE" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding PointCatalogCount}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding PointCatalogProfileName, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="380" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FlatPanelStyle}" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Test Setup" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                        <TextBlock Text="Analyzer Profile" Style="{StaticResource EyebrowTextStyle}" />
                                        <ComboBox ItemsSource="{Binding PointCatalogProfiles}"
                                                  SelectedItem="{Binding SelectedPointCatalogProfile}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                        <TextBlock Text="Polling Baseline" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding PollingProfile}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                                        <TextBlock Text="Current Setup" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Settings.Transport, StringFormat=Transport: {0}}" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Settings.PollingProfile, StringFormat=Profile: {0}}" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding SerialProfile}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource FlatPanelStyle}" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Live Value Viewer" Style="{StaticResource SectionTitleStyle}" />
                                        <DataGrid Grid.Row="1"
                                                  Margin="0,12,0,0"
                                                  ItemsSource="{Binding ValueViewer}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionUnit="FullRow"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="220" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                                <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                                <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="*" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                                <DataGridTextColumn Binding="{Binding Flags}" Header="Flags" Width="90" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                                <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Reason" Width="140" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource FlatPanelStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Recent SCADA Events" Style="{StaticResource SectionTitleStyle}" />
                                        <DataGrid Grid.Row="1"
                                                  Margin="0,12,0,0"
                                                  ItemsSource="{Binding EventLogs}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionUnit="FullRow"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:HH:mm:ss.fff}}" Header="Time" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                                <DataGridTextColumn Binding="{Binding EventType}" Header="Event" Width="150" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                                <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="220" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                                <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                                <DataGridTextColumn Binding="{Binding Detail}" Header="Detail" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Style="{StaticResource FlatPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Command Life Tracker" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Grid.Row="1" Margin="0,14,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LatestTransactionId, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding LatestFinalVerdict, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Margin="0,8,12,0" Text="{Binding LatestTransactionPoint, StringFormat=Point: {0}, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding LatestFeedbackMatch, StringFormat=Match: {0}, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Margin="0,6,12,0" Text="{Binding LatestAcceptanceResult, StringFormat=Acceptance: {0}, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding LatestAcceptanceLatency, Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{Binding LatestFeedbackResult, StringFormat=Feedback: {0}, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding CommandLifecycle}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:HH:mm:ss.fff}}" Header="Time" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                            <DataGridTextColumn Binding="{Binding Stage}" Header="Stage" Width="130" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                            <DataGridTextColumn Binding="{Binding Detail}" Header="Detail" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="3"
                                            Margin="0,14,0,0"
                                            Height="38"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SendBinaryCommand}"
                                            Content="Send Binary Command" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Report Workspace">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource FlatPanelStyle}" Margin="0" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Report Builder" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Structured FAT report assembled from frozen evidence snapshots, not live UI tables."
                                           TextWrapping="Wrap" />
                                    <Separator Margin="0,18,0,18" />
                                    <TextBlock Text="{Binding ReportWorkspaceStageText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                    <Separator Margin="0,14,0,18" />
                                    <StackPanel Visibility="{Binding ReportSetupVisibility}">
                                        <TextBlock Text="Report Branding" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Margin="0,8,0,0" Text="Company" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,10,0,0" Text="Customer" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,10,0,0" Text="Project" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="Prepared By" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBox Margin="0,4,0,0" Text="{Binding PreparedBy, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Reviewed By" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBox Margin="0,4,0,0" Text="{Binding ReviewedBy, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Text="Approved By" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding ApprovedBy, UpdateSourceTrigger=PropertyChanged}" />
