                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Company" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,12" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Customer" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,12" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Project" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,0" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="Prepared By" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,12" Text="{Binding PreparedBy, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Reviewed By" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,12" Text="{Binding ReviewedBy, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Approved By" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,4,0,0" Text="{Binding ApprovedBy, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Margin="0,20,0,0" Width="220" Height="38" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ContinueReportTestingCommand}" Content="Start FAT Wizard" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,28,0,0" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="{Binding ReportBinaryVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="280" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="Binary Indication Verification" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,8,0,0" Text="Review live binary indications against the relay/customer point list, then record the engineering verdict on the right." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                                <DataGrid Margin="0,16,0,0" Height="320" ItemsSource="{Binding BinaryValueRows}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="*" />
                                                        <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="80" />
                                                        <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="120" />
                                                        <DataGridTextColumn Binding="{Binding SourceTimestampText}" Header="Timestamp" Width="180" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#F8FBFC" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="16">
                                                <StackPanel>
                                                    <TextBlock Text="Verification" Style="{StaticResource EyebrowTextStyle}" />
                                                    <TextBlock Margin="0,8,0,0" Text="{Binding BinaryIndicationAssessmentText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Button Margin="0,18,0,0" Height="38" Style="{StaticResource ToolbarPrimaryButtonStyle}" Command="{Binding MarkBinaryMappingCorrectCommand}" Content="Correct" />
                                                    <Button Margin="0,10,0,0" Height="38" Style="{StaticResource ToolbarDangerButtonStyle}" Command="{Binding MarkBinaryMappingIncorrectCommand}" Content="Not Correct" />
                                                    <Button Margin="0,10,0,0" Height="34" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ClearBinaryMappingAssessmentCommand}" Content="Clear Verdict" />
                                                    <TextBlock Margin="0,18,0,0" Text="Remarks" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,6,0,0" MinHeight="112" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding BinaryIndicationRemarks, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,18,0,0" Height="38" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GoToAnalogVerificationCommand}" Content="Next: Analog Values" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,28,0,0" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="{Binding ReportAnalogVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="280" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="Analog Value Verification" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,8,0,0" Text="Review analog magnitudes and quality flags against the expected relay/customer values." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                                <DataGrid Margin="0,16,0,0" Height="320" ItemsSource="{Binding AnalogValueRows}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="*" />
                                                        <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="80" />
                                                        <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="120" />
                                                        <DataGridTextColumn Binding="{Binding Quality}" Header="Quality" Width="130" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#F8FBFC" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="16">
                                                <StackPanel>
                                                    <TextBlock Text="Verification" Style="{StaticResource EyebrowTextStyle}" />
                                                    <TextBlock Margin="0,8,0,0" Text="{Binding AnalogValueAssessmentText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Button Margin="0,18,0,0" Height="38" Style="{StaticResource ToolbarPrimaryButtonStyle}" Command="{Binding MarkAnalogValuesCorrectCommand}" Content="Correct" />
                                                    <Button Margin="0,10,0,0" Height="38" Style="{StaticResource ToolbarDangerButtonStyle}" Command="{Binding MarkAnalogValuesIncorrectCommand}" Content="Not Correct" />
                                                    <Button Margin="0,10,0,0" Height="34" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ClearAnalogValueAssessmentCommand}" Content="Clear Verdict" />
                                                    <TextBlock Margin="0,18,0,0" Text="Remarks" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBox Margin="0,6,0,0" MinHeight="112" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding AnalogValueRemarks, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,18,0,0" Height="38" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GoToCommandSequenceCommand}" Content="Next: Command Test" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,28,0,0" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="{Binding ReportCommandSequenceVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="Command Sequence" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,8,0,0" Text="{Binding CommandSequenceReadinessText}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <DataGrid Margin="0,16,0,0" Height="220" ItemsSource="{Binding GuidedCommandPoints}" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding DisplayLabel}" Header="Command Point" Width="*" />
                                                    <DataGridTextColumn Binding="{Binding FeedbackControl}" Header="Feedback" Width="220" />
                                                    <DataGridTextColumn Binding="{Binding TimeoutMs}" Header="Timeout" Width="100" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Margin="0,12,0,0" Text="{Binding CommandSequenceStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <UniformGrid Margin="0,18,0,0" Columns="2">
                                                <Button Margin="0,0,8,0" Height="40" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunGuidedCommandSequenceCommand}" Content="Run Command Sequence" />
                                                <Button Margin="8,0,0,0" Height="40" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding GoToNonOperationRecoveryCommand}" Content="Skip to Non-operation" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,28,0,0" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="{Binding ReportNonOperationRecoveryVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="Non-operation &amp; Recovery" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,10,0,0" Text="{Binding GuidedTestingProgressStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,10,0,0" Text="{Binding NonOperationStatus}" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding RecoveryStatus}" Foreground="{StaticResource TextMutedBrush}" />
                                            <UniformGrid Margin="0,18,0,0" Columns="2">
                                                <Button Margin="0,0,8,0" Height="40" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunGuidedNonOperationRecoveryCommand}" Content="Run Non-operation + Recovery" />
                                                <Button Margin="8,0,0,0" Height="40" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding GoToReportSummaryCommand}" Content="Skip to Summary" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,28,0,0" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="{Binding ReportSummaryVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="FAT Result Summary" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,12,0,0" Text="{Binding ReportFatExecutionStatus}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding ReportTechnicalResult}" FontSize="15" FontWeight="SemiBold" />
                                            <UniformGrid Margin="0,18,0,0" Columns="5">
                                                <TextBlock Text="{Binding ReportExecutedItemCount, StringFormat=Executed {0}}" />
                                                <TextBlock Text="{Binding ReportPassCount, StringFormat=Pass {0}}" />
                                                <TextBlock Text="{Binding ReportWarningCount, StringFormat=Warn {0}}" />
                                                <TextBlock Text="{Binding ReportFailCount, StringFormat=Fail {0}}" />
                                                <TextBlock Text="{Binding ReportOpenItemCount, StringFormat=Open {0}}" />
                                            </UniformGrid>
                                            <Button Margin="0,20,0,0" Width="220" Height="40" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenReportPreviewCommand}" Content="Preview Report" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1"
                                Visibility="{Binding ReportPreviewVisibility}"
                                Background="{StaticResource ReportPaperBrush}"
                                BorderBrush="#D6DCE4"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F5F8FA"
                                        BorderBrush="#DDE4EC"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="QuestPDF Print Preview" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding ReportPreviewStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ReportEvidenceState}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <wv2:WebView2 x:Name="ReportPdfViewer"
                                              Grid.Row="1"
                                              DefaultBackgroundColor="#FFFEFA" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Value Viewer">
                    <DataGrid Margin="0,14,0,0"
                              ItemsSource="{Binding ValueViewer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="230" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="80" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="*" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Flags}" Header="Flags" Width="90" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Time Quality" Width="130" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding SourceTimestampText}" Header="Source Timestamp" Width="190" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Source}" Header="Variation" Width="150" ElementStyle="{StaticResource GridTextLeftStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Point Database">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource FlatPanelStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Database Profile" Style="{StaticResource EyebrowTextStyle}" />
                                    <ComboBox ItemsSource="{Binding PointCatalogProfiles}"
                                              SelectedItem="{Binding SelectedPointCatalogProfile}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Margin="0,22,12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Use default.json for debugging and ElectraNet.json for FAT metadata." />

                                <Button Grid.Column="2" Width="96" Height="34" Margin="0,22,8,0" Command="{Binding AddPointCatalogEntryCommand}" Content="Add Row" />
                                <Button Grid.Column="3" Width="108" Height="34" Margin="0,22,8,0" Command="{Binding RemovePointCatalogEntryCommand}" Content="Delete Row" />
                                <Button Grid.Column="4" Width="96" Height="34" Margin="0,22,8,0" Command="{Binding ReloadPointCatalogProfileCommand}" Content="Reload" />
                                <Button Grid.Column="5" Width="96" Height="34" Margin="0,22,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SavePointCatalogProfileCommand}" Content="Save" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PointCatalog}"
                                  SelectedItem="{Binding SelectedPointCatalogEntry}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridComboBoxColumn Header="Point Type" Width="140" ItemsSource="{Binding DataContext.PointTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItemBinding="{Binding PointType}" />
                                <DataGridTextColumn Binding="{Binding ObjectVariation}" Header="Obj/Var" Width="90" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding DisplayName}" Header="Display Name" Width="240" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                <DataGridTextColumn Binding="{Binding ScadaTag}" Header="SCADA Tag" Width="160" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                <DataGridTextColumn Binding="{Binding EngineeringRef}" Header="Engineering Ref" Width="180" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                <DataGridTextColumn Binding="{Binding DeviceRef}" Header="Device Ref" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding StateTextOff}" Header="State Off" Width="100" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding StateTextOn}" Header="State On" Width="100" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding IedModel}" Header="IED Model" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding DrawingRef}" Header="Drawing Ref" Width="90" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding DnpClass}" Header="Class" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding DataConcentratorUnit}" Header="DC Unit" Width="80" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding IoRef}" Header="IO Ref" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridCheckBoxColumn Binding="{Binding FeedbackMappingEnabled}" Header="Use Fb" Width="70" />
                                <DataGridTextColumn Binding="{Binding FeedbackControl}" Header="Feedback Control" Width="240" IsReadOnly="True" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                <DataGridTextColumn Binding="{Binding FeedbackIndex}" Header="Fb Idx" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridComboBoxColumn Header="Fb Type" Width="130" ItemsSource="{Binding DataContext.PointTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItemBinding="{Binding FeedbackPointType}" />
                                <DataGridTextColumn Binding="{Binding FeedbackDisplayName}" Header="Feedback Name" Width="220" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                <DataGridTextColumn Binding="{Binding DefaultCommandMode}" Header="Default Mode" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                <DataGridTextColumn Binding="{Binding TimeoutMs}" Header="Timeout ms" Width="90" ElementStyle="{StaticResource GridTextRightStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Command Testing">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FlatPanelStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Binary Control Workflow" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Issue a binary output command and compare request evidence with later command-event or status feedback." TextWrapping="Wrap" />

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Point Index" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBox Text="{Binding CommandPointIndex, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Command Mode" Style="{StaticResource EyebrowTextStyle}" />
                                    <ComboBox ItemsSource="{Binding CommandModes}" SelectedItem="{Binding SelectedCommandMode}" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Binary Operation" Style="{StaticResource EyebrowTextStyle}" />
                                    <ComboBox ItemsSource="{Binding BinaryOperations}" SelectedItem="{Binding SelectedBinaryOperation}" />
                                </StackPanel>

                                <Button Margin="0,18,0,0" Height="38" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendBinaryCommand}" Content="Send Binary Command" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource FlatPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Command Lifecycle Evidence" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid Grid.Row="1"
                                          Margin="0,12,0,0"
                                          ItemsSource="{Binding CommandLifecycle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:HH:mm:ss.fff}}" Header="Time" Width="130" ElementStyle="{StaticResource GridTextCenterStyle}" />
                                        <DataGridTextColumn Binding="{Binding Stage}" Header="Stage" Width="180" ElementStyle="{StaticResource GridTextLeftStyle}" />
                                        <DataGridTextColumn Binding="{Binding Detail}" Header="Detail" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="SCADA Events">
                    <DataGrid Margin="0,14,0,0" ItemsSource="{Binding EventLogs}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding EventTimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Event Time" Width="190" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding EventTimestampBasis}" Header="Time Basis" Width="90" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding EventType}" Header="Event Type" Width="170" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="230" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding PreviousValue}" Header="Previous" Width="100" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="100" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status / Flags" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Quality" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Detail}" Header="Operator Detail" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="SOE Audit">
                    <DataGrid Margin="0,14,0,0" ItemsSource="{Binding SoeAudit}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ReceivedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Captured At" Width="190" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding SourceTimestampText}" Header="Source Timestamp" Width="190" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding ReadType}" Header="Read Type" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding EventClass}" Header="Class" Width="100" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding PointLabel}" Header="Point" Width="230" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding PreviousValue}" Header="Previous" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Flags}" Header="Flags" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Time Quality" Width="120" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Variation}" Header="Variation" Width="130" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Qualifier}" Header="Qualifier" Width="120" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridCheckBoxColumn Binding="{Binding IsBroadcast}" Header="Broadcast" Width="90" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" ElementStyle="{StaticResource GridTextLeftStyle}" />
                            <DataGridTextColumn Binding="{Binding Notes}" Header="Notes" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Link Trace">
                    <DataGrid Margin="0,14,0,0" ItemsSource="{Binding LinkTrace}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Timestamp" Width="190" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Direction}" Header="Channel" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Level}" Header="Level" Width="110" ElementStyle="{StaticResource GridTextCenterStyle}" />
                            <DataGridTextColumn Binding="{Binding Summary}" Header="Trace Detail" Width="*" ElementStyle="{StaticResource GridTextDetailStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
