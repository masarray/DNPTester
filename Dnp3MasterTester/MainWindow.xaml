<Window x:Class="Dnp3MasterTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DNP3 Master Tester"
        Height="920"
        Width="1580"
        MinHeight="760"
        MinWidth="1240">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Margin="16,16,16,12"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="DNP3 Interoperability Tester"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Protection Relay FAT for TCP and Serial sessions. Review SCADA events, SOE evidence, and protocol trace in a single workspace."
                               TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="OpenConnectionSetup_Click"
                            ToolTip="Connection Setup">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M12 3 L19 7 V17 L12 21 L5 17 V7 Z M9 12 H15 M12 9 V15" />
                            <TextBlock Text="Configure" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarPrimaryButtonStyle}"
                            Command="{Binding ConnectCommand}"
                            ToolTip="Connect">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarPrimaryIconPathStyle}"
                                  Data="M5 5 H19 A2 2 0 0 1 21 7 V15 A2 2 0 0 1 19 17 H5 A2 2 0 0 1 3 15 V7 A2 2 0 0 1 5 5 Z M10 9 L15 12 L10 15 Z" />
                            <TextBlock Text="Connect" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarDangerButtonStyle}"
                            Command="{Binding DisconnectCommand}"
                            ToolTip="Disconnect">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarDangerIconPathStyle}"
                                  Data="M5 5 H19 A2 2 0 0 1 21 7 V15 A2 2 0 0 1 19 17 H5 A2 2 0 0 1 3 15 V7 A2 2 0 0 1 5 5 Z M9 9 L15 15 M15 9 L9 15" />
                            <TextBlock Text="Disconnect" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding IntegrityPollCommand}"
                            ToolTip="Integrity Poll">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M5 6 H19 M5 11 H19 M5 16 H13 M16 15 L18 17 L22 13" />
                            <TextBlock Text="Integrity" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding EventPollCommand}"
                            ToolTip="Event Poll">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M4 12 H8 L10 6 L14 18 L16 12 H20" />
                            <TextBlock Text="Event Poll" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding LinkStatusCommand}"
                            ToolTip="Link Status">
                        <StackPanel>
                            <Path Style="{StaticResource ToolbarIconPathStyle}"
                                  Data="M12 4 V8 M12 16 V20 M4 12 H8 M16 12 H20 M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12" />
                            <TextBlock Text="Link Status" Style="{StaticResource ToolbarButtonLabelStyle}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Session Status" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding ConnectionState}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Connection Profile" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding ConnectionProfile}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ConnectionTarget}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Polling Baseline" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding PollingProfile}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Current Setup" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,6,0,0">
                        <Run Text="Transport: " />
                        <Run Text="{Binding Settings.Transport}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Profile: " />
                        <Run Text="{Binding Settings.PollingProfile}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Master / Outstation: " />
                        <Run Text="{Binding Settings.MasterAddress}" />
                        <Run Text=" / " />
                        <Run Text="{Binding Settings.OutstationAddress}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Timeout / Event Poll: " />
                        <Run Text="{Binding Settings.RequestTimeoutSeconds}" />
                        <Run Text="s / " />
                        <Run Text="{Binding Settings.EventPollSeconds}" />
                        <Run Text="s" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="16,0,16,16"
                Padding="14">
            <TabControl>
                <TabItem Header="Overview">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Audit Scope" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,10,0,0" Text="SCADA Events contains binary state change and command event evidence." TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Text="SOE Audit retains callback-oriented forensic records." TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Text="Link Trace is reserved for engine and protocol diagnostics." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Session Summary" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,10,0,0" Text="{Binding ConnectionProfile}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding ConnectionTarget}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding PollingProfile}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Value Viewer">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding ValueViewer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F8F8F8"
                              SelectionUnit="FullRow"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding PointType}" Header="Point Type" Width="180" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="80" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="*" />
                            <DataGridTextColumn Binding="{Binding Flags}" Header="Flags" Width="90" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Time Quality" Width="130" />
                            <DataGridTextColumn Binding="{Binding SourceTimestampText}" Header="Source Timestamp" Width="190" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" />
                            <DataGridTextColumn Binding="{Binding Source}" Header="Variation" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="SCADA Events">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding EventLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F8F8F8"
                              SelectionUnit="FullRow"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Logged At" Width="190" />
                            <DataGridTextColumn Binding="{Binding EventType}" Header="Event Type" Width="170" />
                            <DataGridTextColumn Binding="{Binding PointType}" Header="Point Type" Width="180" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" />
                            <DataGridTextColumn Binding="{Binding PreviousValue}" Header="Previous" Width="100" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="100" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status / Flags" Width="120" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Quality" Width="120" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" />
                            <DataGridTextColumn Binding="{Binding Detail}" Header="Operator Detail" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="SOE Audit">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding SoeAudit}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F8F8F8"
                              SelectionUnit="FullRow"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ReceivedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Captured At" Width="190" />
                            <DataGridTextColumn Binding="{Binding SourceTimestampText}" Header="Source Timestamp" Width="190" />
                            <DataGridTextColumn Binding="{Binding ReadType}" Header="Read Type" Width="120" />
                            <DataGridTextColumn Binding="{Binding EventClass}" Header="Class" Width="100" />
                            <DataGridTextColumn Binding="{Binding PointType}" Header="Point Type" Width="170" />
                            <DataGridTextColumn Binding="{Binding Index}" Header="Index" Width="70" />
                            <DataGridTextColumn Binding="{Binding PreviousValue}" Header="Previous" Width="110" />
                            <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="120" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="110" />
                            <DataGridTextColumn Binding="{Binding Flags}" Header="Flags" Width="110" />
                            <DataGridTextColumn Binding="{Binding Quality}" Header="Time Quality" Width="120" />
                            <DataGridTextColumn Binding="{Binding Variation}" Header="Variation" Width="130" />
                            <DataGridTextColumn Binding="{Binding Qualifier}" Header="Qualifier" Width="120" />
                            <DataGridCheckBoxColumn Binding="{Binding IsBroadcast}" Header="Broadcast" Width="90" />
                            <DataGridTextColumn Binding="{Binding SourceReasonText}" Header="Source Reason" Width="160" />
                            <DataGridTextColumn Binding="{Binding Notes}" Header="Notes" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Link Trace">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding LinkTrace}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F8F8F8"
                              SelectionUnit="FullRow"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Header="Timestamp" Width="190" />
                            <DataGridTextColumn Binding="{Binding Direction}" Header="Channel" Width="110" />
                            <DataGridTextColumn Binding="{Binding Level}" Header="Level" Width="110" />
                            <DataGridTextColumn Binding="{Binding Summary}" Header="Trace Detail" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
