<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\dnp-tester.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('C:\Program Files\Inno Setup 6\ISCC.exe')">C:\Program Files\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    <InstallerOutputDir>$(MSBuildProjectDirectory)\..\artifacts\installer</InstallerOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnp3" Version="1.7.0-RC1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MetadataProfiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dnp-tester-logo.png" />
    <Resource Include="Assets\dnp-tester-icon.png" />
    <Resource Include="Assets\dnp-tester.ico" />
  </ItemGroup>

  <Target Name="BuildReleaseInstaller" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(InnoSetupCompiler)' != ''">
    <MakeDir Directories="$(InstallerOutputDir)" />
    <Exec Command="&quot;$(InnoSetupCompiler)&quot; &quot;$(MSBuildProjectDirectory)\..\Installer\Dnp3MasterTester.iss&quot; /DSourceDir=&quot;$(TargetDir)&quot; /DOutputDir=&quot;$(InstallerOutputDir)&quot; /DAppVersion=&quot;$(Version)&quot;" />
  </Target>

  <Target Name="WarnMissingInnoSetup" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(InnoSetupCompiler)' == ''">
    <Warning Text="Inno Setup compiler was not found. Install Inno Setup 6 or pass /p:InnoSetupCompiler=&quot;C:\Path\To\ISCC.exe&quot; to generate the release installer." />
  </Target>

</Project>
